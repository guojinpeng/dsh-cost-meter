{
  "name": "@guojinpeng/dsh-cost-meter",
  "version": "0.4.1",
  "type": "module",
  "description": "DSH 会话和每轮费用估算插件，支持 models.dev、OpenRouter 和 DeepInfra 价格同步与自定义模型单价。配置位于 ~/.dsh/guojinpeng/dsh-cost-meter/config.json。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "cost",
    "token-meter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/guojinpeng/dsh-cost-meter.git"
  },
  "bugs": {
    "url": "https://github.com/guojinpeng/dsh-cost-meter/issues"
  },
  "homepage": "https://github.com/guojinpeng/dsh-cost-meter",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "scripts": {
    "build": "tsup src/index.js src/client.js --format esm --out-dir dist --clean --no-splitting --loader .css=text",
    "prepack": "npm run build",
    "pack:release": "npm pack",
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}